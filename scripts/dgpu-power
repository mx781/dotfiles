#!/bin/sh
# Switch the discrete NVIDIA GPU between two whole-session modes.
#
#   on   X loads the NVIDIA GPU as a secondary screen (PRIME offload, and the
#        HDMI/Thunderbolt outputs, which are all wired to it on this chassis).
#        The GPU is pinned awake: under RTD3 every resume blocks the
#        single-threaded X server for ~1.5s (measured: an 8ms X round-trip
#        became 1518/1618/1568ms), which reads as the desktop freezing about
#        once a minute. Costs the card's idle draw, ~10W at P0.
#   off  X starts without the NVIDIA GPU at all (AutoAddGPU false, via
#        /etc/X11/p1-dgpu-off.conf), so nothing holds it and RTD3 can put it
#        in D3cold with no freezes. Only the built-in panel works (and
#        DisplayLink, which renders on Intel); prime-run GL/Vulkan does not.
#        CUDA and nvidia-smi still work and wake the card on demand.
#
# Switching restarts X -- every X client is closed. The `startx` wrapper in
# .bash_aliases sees the restart request and starts X again in the new mode.
# The mode lives in /run (tmpfs), so a reboot always comes back `on`.
#
#   dgpu-power            show current state
#   dgpu-power on         GPU in X, pinned awake; restarts X if needed
#   dgpu-power off        GPU out of X, allowed to sleep; restarts X if needed
#   dgpu-power toggle     switch between the two
#   dgpu-power measure    measure the real watt cost, on battery
#   dgpu-power pin        re-pin awake unless `off` (power-mode's hook; no restart)
set -eu

BAT=/sys/class/power_supply/BAT0
AC=/sys/class/power_supply/AC/online
# Same path the p1-power-assert udev hook checks, so a power-source change
# never re-pins the GPU behind an `off`.
OVERRIDE=/run/p1-dgpu-manual-auto
RESTART="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/p1-x-restart"

die() { echo "dgpu-power: $*" >&2; exit 1; }

# Locate the NVIDIA display controller the same way the nvidia role does,
# rather than hard-coding a PCI address that a firmware update could move.
find_gpu() {
    for device in /sys/bus/pci/devices/*; do
        [ "$(cat "$device/vendor" 2>/dev/null)" = 0x10de ] || continue
        case "$(cat "$device/class" 2>/dev/null)" in
            0x0300*) echo "$device"; return 0 ;;
        esac
    done
    return 1
}

GPU=$(find_gpu) || die "no NVIDIA display controller found"
[ -r "$GPU/power/control" ] || die "$GPU/power/control is not readable"

set_control() {
    # The sysfs node is root-owned; everything else here is unprivileged.
    echo "$1" | sudo tee "$GPU/power/control" >/dev/null
}

mode() { if [ -e "$OVERRIDE" ]; then echo off; else echo on; fi; }

# The xinit of this user's running X session, if any.
x_session() { pgrep -u "$(id -u)" -x xinit | head -n 1; }

# Whether the running X server holds the NVIDIA GPU open: its /dev/nvidia*
# nodes or the card's own DRM nodes. Rootless Xorg runs as us, so its fd
# table is readable.
x_holds_gpu() {
    nodes=$(ls "$GPU/drm" 2>/dev/null | sed 's|^|/dev/dri/|' | paste -sd'|' -)
    pattern="/dev/nvidia${nodes:+|$nodes}"
    for pid in $(pgrep -u "$(id -u)" -x Xorg); do
        ls -l "/proc/$pid/fd" 2>/dev/null | grep -Eq -- "-> ($pattern)" && return 0
    done
    return 1
}

restart_x() {
    pid=$(x_session) || true
    [ -n "$pid" ] || { echo "no X session running; plain \`startx\` will use this mode"; return 0; }
    touch "$RESTART"
    echo "restarting X in dgpu-$(mode) mode..."
    # Last thing we do: if this runs from a terminal inside X, it dies here.
    kill -TERM "$pid"
}

go_on() {
    set_control on
    sudo rm -f "$OVERRIDE"
    if [ -n "$(x_session)" ] && ! x_holds_gpu; then restart_x
    else echo "dgpu on: in X, pinned awake"; fi
}

go_off() {
    sudo touch "$OVERRIDE"
    set_control auto
    if [ -n "$(x_session)" ] && x_holds_gpu; then restart_x
    else echo "dgpu off: out of X, free to reach D3cold"; fi
}

# Watts, or empty when the figure is unavailable (on AC, or a full battery
# reports 0, or the driver exposes current/voltage instead of power).
read_watts() {
    if [ -r "$BAT/power_now" ]; then
        awk '{ if ($1 > 0) printf "%.2f", $1 / 1000000 }' "$BAT/power_now"
    elif [ -r "$BAT/current_now" ] && [ -r "$BAT/voltage_now" ]; then
        awk 'NR==1 { i=$1 } NR==2 { v=$1 }
             END { if (i > 0 && v > 0) printf "%.2f", (i * v) / 1000000000000 }' \
            "$BAT/current_now" "$BAT/voltage_now"
    fi
}

on_battery() {
    [ -r "$AC" ] && [ "$(cat "$AC")" = 0 ]
}

status() {
    control=$(cat "$GPU/power/control")
    state=$(cat "$GPU/power/runtime_status")
    active=$(awk '{ printf "%.2f", $1 / 86400000 }' "$GPU/power/runtime_active_time")
    susp=$(awk '{ printf "%.2f", $1 / 86400000 }' "$GPU/power/runtime_suspended_time")

    printf 'gpu        %s\n' "$(basename "$GPU")"
    printf 'mode       %s  (%s)\n' "$(mode)" \
        "$([ "$(mode)" = on ] && echo 'in X, pinned awake' \
                             || echo 'out of X, allowed to sleep')"
    if [ -n "$(x_session)" ]; then
        if x_holds_gpu; then x=yes; else x=no; fi
        printf 'x holds    %s\n' "$x"
        if { [ "$(mode)" = on ] && [ "$x" = no ]; } \
        || { [ "$(mode)" = off ] && [ "$x" = yes ]; }; then
            printf '           ^ X was started in the other mode; `dgpu %s` restarts it\n' "$(mode)"
        fi
    fi
    printf 'control    %s\n' "$control"
    printf 'state      %s\n' "$state"
    printf 'lifetime   %s days active / %s days suspended\n' "$active" "$susp"

    if on_battery; then
        watts=$(read_watts)
        printf 'power      battery%s\n' "${watts:+, drawing ${watts} W}"
    else
        printf 'power      AC\n'
    fi
}

measure() {
    on_battery || die "run this on battery: power_now reads 0 on AC"
    [ "$(cat "$BAT/status" 2>/dev/null)" = Discharging ] \
        || die "battery is not discharging; unplug and let it settle first"

    original=$(cat "$GPU/power/control")
    # Restore whatever was there even if we are interrupted part way.
    trap 'set_control "$original" 2>/dev/null || true' EXIT INT TERM

    echo "Pinning the GPU awake for a baseline..."
    set_control on
    sleep 15
    base=$(read_watts)
    [ -n "$base" ] || die "could not read a power figure from $BAT"
    echo "  baseline (GPU awake):   $base W"

    echo "Allowing RTD3 and waiting for D3cold$(x_holds_gpu && echo ' (X holds it: expect some freezes)')..."
    set_control auto
    waited=0
    while [ "$(cat "$GPU/power/runtime_status")" != suspended ]; do
        [ "$waited" -ge 90 ] && die "GPU never reached D3cold; something is holding it awake"
        sleep 5
        waited=$((waited + 5))
    done
    echo "  reached D3cold after ${waited}s; settling..."
    sleep 15
    susp=$(read_watts)
    [ -n "$susp" ] || die "could not read a power figure from $BAT"
    echo "  suspended (D3cold):     $susp W"

    set_control "$original"
    trap - EXIT INT TERM
    echo "  restored control=$original"

    full=$(awk '{ printf "%.2f", $1 / 1000000 }' "$BAT/energy_full" 2>/dev/null || echo 0)
    echo
    awk -v b="$base" -v s="$susp" -v wh="$full" 'BEGIN {
        d = b - s
        if (d <= 0) {
            print "The awake reading was not higher than the suspended one."
            print "Noise from background load most likely swamped the GPU; retry on an idle desktop."
            exit
        }
        printf "dGPU idle draw      %.2f W\n", d
        printf "runtime lost        %.0f%% (%.0f min per hour you would have had)\n", \
            100 * d / b, 60 * d / b
        if (wh > 0)
            printf "on this %.0f Wh pack  %.2f h on  vs  %.2f h off\n", wh, wh / b, wh / s
    }'
}

case "${1:-status}" in
    status|"")  status ;;
    on)         go_on ;;
    off)        go_off ;;
    toggle)     if [ "$(mode)" = on ]; then go_off; else go_on; fi ;;
    pin)        [ "$(mode)" = off ] || set_control on ;;
    measure)    measure ;;
    auto)       die "'auto' is now 'off' (takes the GPU out of X and restarts X)" ;;
    -h|--help|help)
        sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)  die "unknown command '$1' (try: status, on, off, toggle, measure)" ;;
esac
