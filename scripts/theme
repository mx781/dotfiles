#!/usr/bin/env python3
"""Generate application-specific theme adapters from the selected palette."""
from pathlib import Path
import os
import subprocess
import sys
import tomllib


ROOT = Path(__file__).resolve().parent.parent
DEFAULT_THEME = ROOT / "themes" / "current.toml"
SELECTED_THEME = ROOT / "themes" / "selected.toml"


def write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)


def activate_xmonad() -> None:
    """Rebuild and replace the live XMonad session after an interactive switch."""
    if not os.environ.get("DISPLAY"):
        return
    xmonad_dir = ROOT / ".xmonad"
    binary = xmonad_dir / "xmonad-x86_64-linux"
    subprocess.run([str(xmonad_dir / "build"), str(binary)], cwd=xmonad_dir, check=True)
    # The configured restart binding does the same cleanup before replacing the
    # window manager.  Doing it here prevents duplicate old-colour bars.
    for process in ("conky", "dzen2", "trayer"):
        subprocess.run(["pkill", "-u", str(os.getuid()), "-x", process], check=False)
    subprocess.run([str(binary), "--restart"], check=True)


def main() -> None:
    interactive_switch = False
    if len(sys.argv) == 3 and sys.argv[1] == "use":
        selected = ROOT / "themes" / f"{sys.argv[2]}.toml"
        if not selected.is_file():
            raise SystemExit(f"Unknown theme: {sys.argv[2]}")
        if SELECTED_THEME.exists() or SELECTED_THEME.is_symlink():
            SELECTED_THEME.unlink()
        SELECTED_THEME.symlink_to(selected.name)
        interactive_switch = True
    elif len(sys.argv) == 2 and sys.argv[1] == "reset":
        if SELECTED_THEME.exists() or SELECTED_THEME.is_symlink():
            SELECTED_THEME.unlink()
        interactive_switch = True
    elif len(sys.argv) != 2 or sys.argv[1] != "apply":
        raise SystemExit("Usage: theme apply | theme use NAME | theme reset")
    theme = SELECTED_THEME if SELECTED_THEME.is_file() else DEFAULT_THEME
    colors = tomllib.loads(theme.read_text())["colors"]
    required = {
        "wallpaper", "background", "foreground", "accent", "status_accent", "muted",
        "border_normal", "border_focused", "urgent", "status_foreground",
        "battery_urgent", "battery_warning",
    }
    missing = required - colors.keys()
    if missing:
        raise SystemExit(f"Missing theme colors: {', '.join(sorted(missing))}")

    write(ROOT / ".xmonad" / "Theme.hs", f'''module Theme where
themeWallpaper, themeBackground, themeForeground, themeAccent, themeStatusAccent, themeMuted :: String
themeBorderNormal, themeBorderFocused, themeUrgent, themeStatusForeground :: String
themeBatteryUrgent, themeBatteryWarning :: String
themeWallpaper = "{colors['wallpaper']}"
themeBackground = "{colors['background']}"
themeForeground = "{colors['foreground']}"
themeAccent = "{colors['accent']}"
themeStatusAccent = "{colors['status_accent']}"
themeMuted = "{colors['muted']}"
themeBorderNormal = "{colors['border_normal']}"
themeBorderFocused = "{colors['border_focused']}"
themeUrgent = "{colors['urgent']}"
themeStatusForeground = "{colors['status_foreground']}"
themeBatteryUrgent = "{colors['battery_urgent']}"
themeBatteryWarning = "{colors['battery_warning']}"
''')
    write(ROOT / ".xmonad" / "theme-conky.lua", "\n".join(
        ["local colors = {"]
        + [f"  {name} = '{value}'," for name, value in colors.items()]
        # Conky exposes Lua functions to ${lua ...} only when their names begin
        # with `conky_`; `${lua theme_color status_accent}` consequently calls
        # this function as `conky_theme_color("status_accent")`.
        + ["}", "function conky_theme_color(name) return colors[name] end", ""]
    ))
    def ansi(hex_color: str) -> str:
        red, green, blue = (int(hex_color[index:index + 2], 16) for index in (1, 3, 5))
        escape = chr(92)
        return f"{escape}[{escape}e[38;2;{red};{green};{blue}m{escape}]"
    reset = f"{chr(92)}[{chr(92)}e[0m{chr(92)}]"
    write(ROOT / ".config" / "shell" / "theme-prompt.sh", f'''# Generated by `theme apply`; do not edit.
PS1='${{debian_chroot:+($debian_chroot)}}{ansi(colors['border_focused'])}\\u@\\h{reset}:{ansi(colors['accent'])}\\w{reset}\\$ '
''')
    if interactive_switch:
        activate_xmonad()


if __name__ == "__main__":
    main()
