partial alphanumeric_keys
xkb_symbols "lv_pok3r_p1" {
    include "lv(apostrophe)"
    // Set up level 3 modifiers.
    # include "level3(bksl_switch)"
    include "level3(caps_switch)"
    // Set up level 5 modifiers.
    include "level5(caps_switch)"
    include "level5(ralt_switch)"

    key.type[Group1] = "EIGHT_LEVEL";

    key <ESC> {
        type= "EIGHT_LEVEL",
        symbols[Group1]= [ Escape, asciitilde, NoSymbol, NoSymbol, grave, asciitilde, NoSymbol, NoSymbol ]
    };

    key <AE01> { [ 1, exclam, NoSymbol, NoSymbol, F1 ] };
    key <AE02> { [ 2, at,     NoSymbol, NoSymbol, F2 ] };
    key <AE03> { [ 3, numbersign, NoSymbol, NoSymbol, F3 ] };
    key <AE04> { [ 4, dollar,     NoSymbol, NoSymbol, F4 ] };
    key <AE05> { [ 5, percent,    NoSymbol, NoSymbol, F5 ] };
    key <AE06> { [ 6, asciicircum,NoSymbol, NoSymbol, F6 ] };
    key <AE07> { [ 7, ampersand,  NoSymbol, NoSymbol, F7 ] };
    key <AE08> { [ 8, asterisk,   NoSymbol, NoSymbol, F8 ] };
    key <AE09> { [ 9, parenleft,  NoSymbol, NoSymbol, F9 ] };
    key <AE10> { [ 0, parenright, NoSymbol, NoSymbol, F10 ] };
    key <AE11> { [ minus, underscore, NoSymbol, NoSymbol, F11 ] };
    key <AE12> { [ equal, plus,      NoSymbol, NoSymbol, F12 ] };
    
    key <AC07> { [
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        Left, Left
    ] };
    key <AC08> { [ 
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        Down, Down
    ] };
    key <AC09> { [
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        Right, Right
    ] };
    key <AD08> { [
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        Up, Up
    ] };
    key <AD07> { [
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        Prior, Prior
    ] };
    key <AD09> { [
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        Next, Next
    ] };
    key <AC06> { [
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        Home, Home
    ] };
    key <AB06> { [
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        End, End
    ] };
    key <AD10> { [
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        Print, Print
    ] };
    key <BKSP> { [
        NoSymbol, NoSymbol, NoSymbol, NoSymbol,
        Delete, Delete
    ] };
};
